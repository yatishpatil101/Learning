# Live-API mode — loaded ONLY by `npm run dev:live` (`vite --mode live`).
#
# Vite layers env files as: .env < .env.local < .env.live, so this file overrides the
# defaults in .env while leaving the Google Maps key there untouched. `npm run dev`
# is unaffected and still runs fully on mocks.
#
# NEVER put a secret here — unlike every other .env file this one is tracked (see the
# `!.env.live` exception in the root .gitignore).
#
# `*` = every domain that has an http provider goes live (src/services/config.js).
VITE_API_DOMAINS=*

# Deliberately NOT set here: VITE_PROXY_TARGET. vite.config.js reads it from
# `process.env`, and Vite only loads .env files into `import.meta.env` — so a value
# here would be silently ignored. Its default is already http://localhost:8080, which
# is what the backend serves (server.port=${PORT:8080}, context-path=/api). To point
# at another port, set it in the shell before `npm run dev:live`.
