{
  "name": "punenest-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "check:i18n": "node scripts/check-i18n-keys.cjs && node scripts/check-i18n-locales.cjs",
    "check:help": "node scripts/check-help-content.cjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check": "npm run lint && npm run check:i18n && npm run check:help",
    "e2e": "npm --prefix ../e2e test",
    "e2e:ui": "npm --prefix ../e2e test -- --ui",
    "e2e:report": "npm --prefix ../e2e run report",
    "i18n:report": "node scripts/i18n-report.cjs",
    "preview": "vite preview",
    "seed": "node scripts/generate-seed.mjs",
    "import:rera": "node scripts/import-rera.mjs",
    "rename:brand": "node scripts/rename-brand.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vis.gl/react-google-maps": "^1.9.0",
    "chart.js": "^4.4.7",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.2.7",
    "react-i18next": "^15.7.4",
    "react-router": "^7.18.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "marked": "^15.0.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
