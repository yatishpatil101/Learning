# ── Backend integration ─────────────────────────────────────────────────────
# Which domains talk to the real API: all of them, always. There is no switch.
# `VITE_API_DOMAINS` and `VITE_API_MODE` stood here and are gone — nothing reads
# them, and no value you could put in this file will route a domain anywhere but
# the server. Every page therefore needs the backend running; see docs/LOCAL_DEV.md.

# API base. Keep the relative "/api" in dev: the Vite proxy forwards it to
# localhost:8080 with the path intact (the backend serves under
# server.servlet.context-path=/api), so requests stay same-origin — no CORS, and
# the page's `connect-src 'self'` CSP is satisfied. Only set an absolute URL when
# pointing a built bundle at a deployed backend, and include /api when you do:
#   VITE_API_BASE=https://api.draazy.in/api
#
# In a *deploy*, prefer leaving this relative and setting API_ORIGIN instead (below).
# An absolute base is the cross-origin topology, and this app is not configured for it:
# the CSP ships `connect-src 'self'`, and if the UI ends up on its own registrable domain
# (any *.netlify.app) the SameSite=Lax refresh cookie is never returned, so every session
# dies at the first token expiry — which is why CookieDeliveryCheck refuses to boot into it.
VITE_API_BASE=/api

# ── Deploy-only, and NOT a VITE_ variable ───────────────────────────────────
# The backend origin that the host proxies /api to. Read by scripts/gen-redirects.mjs at
# `postbuild`, which writes dist/_redirects; it never reaches the bundle, so it is a build
# input rather than client config. Unset locally — the Vite dev server proxies /api itself.
# Scheme + host only: the /api prefix comes from the request path and is forwarded verbatim.
#   API_ORIGIN=https://api.draazy.in
#
# Set it and two backend values follow from it, both mandatory in the prod profile:
#   WEB_ORIGINS        = the UI origin (what the proxy forwards as `Origin`), e.g. https://draazy.in
#   API_PUBLIC_ORIGIN  = the same UI origin, because with a path proxy that is the origin the
#                        *browser* uses to reach the API. CookieDeliveryCheck compares these.

# Override the dev proxy target (defaults to http://localhost:8080).
# VITE_PROXY_TARGET=http://localhost:8080

# Google Maps JavaScript API key (PropertyMap / ShareMap display).
# SECURITY — lock this browser key down in Google Cloud Console (it is public in the bundle):
#   1. Application restriction → "HTTP referrers (web sites)". Add your domains only, e.g.
#        https://draazy.com/*   https://www.draazy.com/*   http://localhost:*/*  (dev)
#   2. API restriction → "Restrict key" and enable ONLY: Maps JavaScript API.
#      (Add Places API / Geocoding API only if/when the browser calls them directly.)
#   3. Set a daily quota cap + a billing budget alert to bound abuse cost.
# Left blank on purpose: a previous value leaked, and an example file is the wrong place
# for a real key. Copy this to .env.local and paste your own restricted key there.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Map ID for Advanced Markers. Falls back to Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# ── PMF test overlay (temporary) ────────────────────────────────────────────
# Turns on the public product-market-fit test build: "early preview" banner,
# GA4 funnel analytics, and Netlify Forms lead capture. Leave OFF/unset for
# normal development — every PMF hook is a no-op unless this is exactly "on".
VITE_PMF_MODE=off
# GA4 Measurement ID (public by design). Only used when VITE_PMF_MODE=on.
VITE_GA_ID=
