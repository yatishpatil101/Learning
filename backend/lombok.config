# Lombok configuration — see docs/system/tech-debt.md §1 for the full reasoning.
#
# This file is the load-bearing half of the Lombok adoption. The dependency saves boilerplate; this
# file is what stops Lombok from quietly undoing three deliberate design decisions. Every rule below
# is `ERROR`, not `WARNING`, because a warning in a build that prints thousands of lines is a rule
# nobody enforces.

# Stop Lombok looking further up the tree for another config.
config.stopBubbling = true

# --- The ban list -------------------------------------------------------------------------------

# @ToString — the sharp one. Slice 3 made User.mobile masked at every edge and ensured
# masked_aadhaar never reaches a log. A generated toString() on User or IdentityVerification
# re-opens exactly that hole through the back door: one log.debug("{}", user) and the unmasked
# number is in the log file. The mask is enforced in mappers; a toString bypasses every mapper.
lombok.toString.flagUsage = ERROR

# @EqualsAndHashCode — a generated equals spans all fields on a JPA entity. That triggers lazy
# loads from inside equals(), and identity changes when the id goes null -> assigned, which
# silently breaks Set membership across a persist. JPA identity is the id, and only the id.
lombok.equalsAndHashCode.flagUsage = ERROR

# @Data — bundles both of the above plus @Setter on every field. Banned for all those reasons at
# once, and because it would add setters to the ~345 entity fields that deliberately have none.
lombok.data.flagUsage = ERROR

# @Builder — fights the design. Constructors like
#   new Property(owner, title, deal, type, price, locality, city)
# ARE the invariant: they are why a Property cannot exist without an owner or a deal. A builder
# makes every required field optional again and moves the failure from compile time to run time.
lombok.builder.flagUsage = ERROR

# @Value / @AllArgsConstructor / @RequiredArgsConstructor — DTOs stay records (§1), and entities
# need their explicit constructors to keep encoding invariants. An all-args constructor on an
# entity is a positional trap: two adjacent String fields silently swap at the call site.
lombok.value.flagUsage = ERROR
lombok.allArgsConstructor.flagUsage = ERROR
lombok.requiredArgsConstructor.flagUsage = ERROR

# @SneakyThrows — laundering a checked exception into an unchecked one at a random stack frame is
# how an error stops being handled anywhere.
lombok.sneakyThrows.flagUsage = ERROR

# --- What is allowed ----------------------------------------------------------------------------
# @Getter and @Setter only, and @Setter only at field level. See tech-debt.md §1.

# Mark generated accessors so coverage and static analysis can tell them from hand-written code.
lombok.addLombokGeneratedAnnotation = true

# Do not emit @java.beans.ConstructorProperties; it pulls in java.desktop and nothing here reads it.
lombok.anyConstructor.addConstructorProperties = false
