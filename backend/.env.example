# Cashfree + backend local run configuration (TEMPLATE — safe to commit).
#
# Copy this file to `.env.local` in the same folder and fill in real values there.
# `.env.local` is git-ignored (root .gitignore: `.env.*` and `*.local`), so real
# keys never enter version control. NEVER put real keys in this file.
#
# The launcher `backend/run-local.ps1` loads `.env.local` into the process
# environment, then starts Spring Boot. Spring maps each var via
# `application.properties` (${CASHFREE_*}). Secrets stay server-side only.

# Master switch. Leave false to run on the mock providers (no vendor account
# needed). Flip to true ONLY after the two keys below are filled in — CashfreeClient
# refuses to boot when enabled=true and a key is blank.
CASHFREE_ENABLED=false

# Sandbox for TEST_ keys; https://api.cashfree.com for live PROD_ keys.
# The host and the key prefix must match or every call 401s.
CASHFREE_BASE_URL=https://sandbox.cashfree.com

# From Cashfree dashboard → Developers → API Keys (test environment).
# App ID = x-client-id, Secret Key = x-client-secret. Backend-only; never VITE_*.
CASHFREE_APP_ID=replace_me
CASHFREE_SECRET_KEY=replace_me

# From Cashfree dashboard → Developers → Webhooks. Signs inbound payment/KYC
# callbacks (HMAC-SHA256). A blank value makes every forged signature valid.
CASHFREE_WEBHOOK_SECRET=replace_me

# Where DigiLocker returns the user after Aadhaar consent.
CASHFREE_KYC_REDIRECT_URL=https://punenest.in/verify/complete
