# Logs
logs
*.log
npm-debug.log*

# Dependencies
node_modules
dist
dist-ssr
*.local

# Persisted user data (dev-only, regenerated by the app)
data/persist/
**/data/persist/

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Environment — never commit real keys (Google Maps key lives here).
# Vite exposes VITE_* to the client bundle, so the Maps key must ALSO be
# HTTP-referrer-restricted in Google Cloud Console.
.env
.env.*
!.env.example

.vite
target/
# CLI Maven builds here (backend/.mvn/maven.config) so they never collide with the
# VS Code Java language server, which owns target/.
target-cli/
test-results/
playwright-report/
playwright/.cache/

# Editor / scratch artifacts (never commit temp duplicates)
*.jsx.new
*.new
*.orig
*.original.jsx
*.rollback
_rollback/
.rollback/


# Local, machine-specific DB status snapshot (durable setup docs live in docs/LOCAL_DEV.md).
backend/LOCAL_DB_STATUS.md
